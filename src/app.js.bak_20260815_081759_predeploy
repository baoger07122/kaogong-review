    });
    row2.appendChild(grpIndent);

    // 其他工具组
    const grpExtra = document.createElement('div');
    grpExtra.className = 'notion-toolbar__grp';
    const extraBtns = [
      { b: '"', t: 'quote', title: '引用' },
      { b: '—', t: 'divider', title: '分割线' },
      { b: '⊞', t: 'table', title: '表格' },
    ];
    extraBtns.forEach(x => {
