      </div>
      <div class="worddb-form-group">
        <label class="worddb-form-label">拼音</label>
        <input type="text" class="worddb-form-input" id="wf-pinyin" value="${this._escapeHtml(word.pinyin || '')}" placeholder="拼音（可选）">
      </div>
