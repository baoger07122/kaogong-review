      addRow.appendChild(addInput);
      addRow.appendChild(addBtn);
      modBody.appendChild(addRow);

      modEl.appendChild(modBody);
      return modEl;
    };

    // 科目级：标题 + 模块列表
    App.Constants.SUBJECTS.forEach(subject => {
      const subjEl = document.createElement('div');
